{
  "mcpServers": {
    "aidesk-host": {
      "command": "node",
      "args": [
        "./scripts/host-task-server.mjs"
      ],
      "cwd": ".",
      "env_vars": [
        "CODEX_HOME"
      ]
    },
    "aidesk-authority": {
      "type": "http",
      "url": "https://aideskx.com/mcp",
      "http_headers": {
        "X-Aidesk-Goal-Catalog": "goal-community-v7",
        "X-Aidesk-Plugin-Version": "1.1.15+codex.20261003143000",
        "X-Aidesk-Network-Reports": "v1",
        "X-Aidesk-Goal-Recent": "v1"
      }
    }
  }
}
