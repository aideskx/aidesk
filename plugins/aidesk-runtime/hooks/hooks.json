{
  "description": "Original bounded 02 probe and authenticated 05 teaching observation; normal host Hook trust required.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/teaching-source-hook.mjs\" --hook UserPromptSubmit",
            "timeout": 3
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/teaching-plugin-hook.mjs\" --hook UserPromptSubmit",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/teaching-source-hook.mjs\" --hook Stop",
            "timeout": 3
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/teaching-plugin-hook.mjs\" --hook Stop",
            "timeout": 3
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^mcp__aidesk[_-]authority__aidesk_(check_selection|load_teaching_skill|read_content_catalog|read_content|record_content_adoption|content_operation_status)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/teaching-source-hook.mjs\" --hook PreToolUse",
            "timeout": 3
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/teaching-plugin-hook.mjs\" --hook PreToolUse",
            "timeout": 3
          }
        ],
        "matcher": "^mcp__aidesk[_-]authority__aidesk_(account_status|entry_context|check_selection|teaching_[a-z_]+)$"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^mcp__aidesk[_-]authority__aidesk_(account_status|check_selection|load_teaching_skill|read_content_catalog|read_content|record_content_adoption|content_operation_status)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/teaching-source-hook.mjs\" --hook PostToolUse",
            "timeout": 3
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/teaching-plugin-hook.mjs\" --hook PostToolUse",
            "timeout": 3
          }
        ],
        "matcher": "^mcp__aidesk[_-]authority__aidesk_(account_status|entry_context|check_selection|teaching_[a-z_]+)$"
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/teaching-plugin-hook.mjs\" --hook Interrupt",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/teaching-plugin-hook.mjs\" --hook SessionEnd",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
