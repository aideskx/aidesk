{
  "description": "CLI-native goal lifecycle fence. Only target MCP calls; never captures prompt or Stop events.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^mcp__aidesk[_-]authority__aidesk_goal_.*$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/lifecycle-hook.mjs\" --hook PreToolUse",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "^mcp__aidesk[_-]authority__aidesk_(account_status|platform_account_prepare|platform_subscription_read|check_plugin_update)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/lifecycle-hook.mjs\" --hook PreToolUse",
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^mcp__aidesk[_-]authority__aidesk_goal_.*$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/lifecycle-hook.mjs\" --hook PostToolUse",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "^mcp__aidesk[_-]authority__aidesk_(account_status|platform_account_prepare|platform_subscription_read|check_plugin_update)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/lifecycle-hook.mjs\" --hook PostToolUse",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
